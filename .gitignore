# Python environments
.venv/
.runtime-packages*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local settings
.env

# User supplied or generated data
/data/raw/cicids2017/*.csv
/data/raw/nsl_kdd/**
/nsl_kdd_full_test_upload.csv
/data/interim/**
/data/processed/**
/data/runs/**
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/runs/.gitkeep

# Keep the active NSL-KDD model in Git so the backend works after checkout.
# Other generated model bundles remain local.
/models/**
!/models/
!/models/ml_ctd/
!/models/ml_ctd/xgboost_model.pkl
!models/.gitkeep

# Generated figures
/reports/figures/**
!reports/figures/.gitkeep

# Optional local database files
*.sqlite
*.db

# Local service logs
.runtime-logs/


